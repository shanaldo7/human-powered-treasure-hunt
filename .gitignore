# ==============================================================================
# UNT — HUMAN-POWERED TREASURE HUNT (.gitignore)
# ==============================================================================

# Node dependencies
node_modules/
.pnp
.pnp.js

# Build and distribution artifacts
dist/
build/
out/
server.js

# Environment variables & secrets (NEVER commit secrets or API keys)
.env
.env.*
!.env.example
.env.local
.env.development.local
.env.test.local
.env.production.local

# API keys and credentials
*.pem
*.key
*.cert
*.pfx
credentials.json
client_secret*.json

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
*.log

# Editor & OS files
.DS_Store
.AppleDouble
.LSOverride
Thumbs.db
ehthumbs.db
.idea/
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Testing & coverage
coverage/
.nyc_output/

# Caches & temporary files
.cache/
.parcel-cache/
.eslintcache
.stylelintcache
.turbo/
.gmp_cache/
*.tsbuildinfo

# Python virtual environments & caches (if any python scripts are used)
venv/
.venv/
env/
.env/
__pycache__/
*.pyc
*.pyo
*.pyd
