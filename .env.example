# ==============================================================================
# UNT — HUMAN-POWERED TREASURE HUNT (.env.example)
# All values are non-secret placeholders. Never place real API credentials here.
# ==============================================================================

# GOOGLE GEMINI AI ENGINE (BACKEND-ONLY)
# API key for clue crafting, real-world discovery verification, and Hunt Guide chat.
GEMINI_API_KEY="your_gemini_api_key_here"

# Optional: Override the automatically discovered Gemini model (defaults to auto-discovered flash model)
GEMINI_MODEL="gemini-3.8-flash"

# REAL-WORLD RESEARCH (OPTIONAL BUT RECOMMENDED)
# SerpApi key for factual live web research (Google Search / Google News).
SERPAPI_KEY="your_serpapi_key_here"

# GOOGLE MAPS PLATFORM (OPTIONAL EMBED PREVIEWS)
# Google Maps API key for on-screen map previews. (Maps directions links work without a key)
GOOGLE_MAPS_API_KEY="your_google_maps_api_key_here"
VITE_GOOGLE_MAPS_API_KEY="your_google_maps_api_key_here"

# SERVER CONFIGURATION
PORT=3000
APP_URL="http://localhost:3000"
